# Banco
# Local: postgresql://postgres:postgres@localhost:5432/indusense?schema=public
# Supabase: Connect > Session pooler (porta 5432). Ex.:
# postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/indusense?schema=public"

# Servidor (o Next.js usa a 3000, por isso a API fica na 3333)
PORT=3333
API_PREFIX=v1

# Autenticação
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-caracteres-ou-mais
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# O Flutter tem tela de cadastro; o Next.js não. Coloque false para fechar o /auth/register.
ALLOW_PUBLIC_REGISTER=true

# Origens liberadas no CORS (separadas por vírgula). Use * para liberar tudo (ex.: Flutter Web em porta aleatória).
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Chave dos dispositivos ESP32 para enviar leituras em POST /readings (header x-api-key)
DEVICE_API_KEY=troque-esta-chave-dos-dispositivos

# Regras de monitoramento
SENSOR_OFFLINE_MINUTES=30
# Quanto acima/abaixo do limite (em fração) o valor passa de "atencao" para "critico"
ALERT_CRITICAL_MARGIN=0.15
APP_TIMEZONE=America/Sao_Paulo

# Sistema de câmera / EPI
# Sem envio do sistema de câmera por este tempo, a câmera aparece offline
CAMERA_OFFLINE_SECONDS=60
# Pasta onde ficam as fotos das ocorrências de EPI
EPI_UPLOAD_DIR=uploads/epi
# Tamanho máximo do corpo JSON (as fotos chegam em base64)
BODY_LIMIT=8mb

# Login social (app). Deixe vazio para desligar.
# Google: IDs de cliente OAuth aceitos (iOS e Web/Android), separados por vírgula
GOOGLE_CLIENT_IDS=
# Apple: bundle IDs do app (ex.: com.suaempresa.indusense), separados por vírgula
APPLE_CLIENT_IDS=

# Supabase Storage para as fotos das ocorrências (obrigatório quando a API roda na nuvem).
# Vazio = salva as fotos na pasta EPI_UPLOAD_DIR do computador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=epi-fotos
